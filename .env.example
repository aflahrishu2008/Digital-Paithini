# Supabase Project Configuration
# Get these from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storage bucket name (must match supabase/schema.sql)
VITE_SUPABASE_BUCKET=digital-paithini-files

# Internal email domain appended when users sign in with a short username
# Example: logging in with username "rahul" authenticates "rahul@digitalpaithini.local"
VITE_AUTH_EMAIL_DOMAIN=digitalpaithini.local
